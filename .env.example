# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=brandos
POSTGRES_PASSWORD=changeme_use_a_real_secret
POSTGRES_DB=brandos
POSTGRES_PORT=5432
# Internal hostname used by other containers on the same Docker network
POSTGRES_HOST=db

# --- Reserved for a future LLM provider (Phase 1 currently uses a stub, no key needed) ---
# LLM_PROVIDER=claude
# LLM_API_KEY=

# --- Delivery ---
# "console" (default, just prints to logs) or "twilio"
DELIVERY_PROVIDER=console

# Only needed if DELIVERY_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
