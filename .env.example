# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=brandos
POSTGRES_PASSWORD=changeme_use_a_real_secret
POSTGRES_DB=brandos
POSTGRES_PORT=5432
# Internal hostname used by other containers on the same Docker network
POSTGRES_HOST=db

# --- LLM provider ---
# "stub" (default, no API key needed, produces placeholder content) or "openrouter"
LLM_PROVIDER=stub

# Only needed if LLM_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Defaults to the free Nemotron 3 Ultra tier if not set:
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Delivery ---
# "console" (default, just prints to logs) or "twilio"
DELIVERY_PROVIDER=console

# Only needed if DELIVERY_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
